<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.anthropic.claude" />
        <package android:name="com.anthropic.aibo" />
    </queries>
    <application android:label="Claude Privacy Hook" android:allowBackup="false">
        <activity
            android:name=".ExportDiagnosticsActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode" />
        <provider
            android:name=".BridgeProvider"
            android:authorities="dev.chx.claudeprivacy.bridge"
            android:exported="true"
            android:grantUriPermissions="true" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Privacy controls for Claude and Claude Duet" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
